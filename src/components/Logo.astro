---
/**
 * 站点 Logo。Quickemu 官方标志是 512×512 的方形 PNG，
 * 因此容器必须保持正方形（配合 object-contain），否则会被拉伸变形。
 */
import logo from "@/assets/logo.png";

interface Props { class?: string }
const { class: cls = "h-6 w-6" } = Astro.props;
---
<img
  src={logo.src}
  alt=""
  width={logo.width}
  height={logo.height}
  decoding="async"
  class={`object-contain ${cls}`}
/>
