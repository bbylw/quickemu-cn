---
/**
 * 落地页 —— 根路由 `/`。
 *
 * 独立于文档布局：没有侧边栏与目录栏，只保留页头与页脚，
 * 面向第一次接触 Quickemu 的访客；文档统一挂在 /docs 下。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LinkButton } from "../components/ui/link-button";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;

const base = import.meta.env.BASE_URL;
const docsHref = withBase("/docs", base);
const installHref = withBase("/docs/installation", base);
const featuresHref = withBase("/docs/features", base);
const logoHref = withBase("/images/logo.png", base);
const githubHref = "https://github.com/quickemu-project/quickemu";

/** 工作方式：三条命令串起整个流程。 */
const steps = [
  {
    icon: "ph:download-simple",
    title: "拉取镜像",
    body: "quickget 自动从上游获取官方 ISO，无需手动翻找下载链接。",
    cmd: "quickget <os> <release> [edition]",
  },
  {
    icon: "ph:cube",
    title: "生成配置",
    body: "自动写入一份最优虚拟机配置：CPU、内存、磁盘、网络一次到位。",
    cmd: "nixos-unstable-minimal.conf",
  },
  {
    icon: "ph:lightning",
    title: "启动虚拟机",
    body: "quickemu 读取配置，枚举你的硬件并按最佳参数启动。",
    cmd: "quickemu --vm <config>",
  },
];

/** 核心能力。 */
const features = [
  {
    icon: "ph:monitor",
    title: "跨平台宿主机",
    body: "在 Linux 与 macOS 上原生运行，自动枚举硬件并套用最优配置。",
  },
  {
    icon: "ph:windows-logo",
    title: "Windows 11 + TPM 2.0",
    body: "内置 TPM 2.0、Secure Boot 与 EFI 支持，覆盖 Windows 10/11 及 Server。",
  },
  {
    icon: "ph:apple-logo",
    title: "macOS 全线支持",
    body: "从 Sequoia 到 Mojave，一条 quickget 命令即可拉起 macOS 虚拟机。",
  },
  {
    icon: "ph:hard-drives",
    title: "文件共享与剪贴板",
    body: "SPICE、VirtIO-webdavd/9p 与 Samba，宿主与客户机之间无缝互通。",
  },
  {
    icon: "ph:usb",
    title: "硬件直通",
    body: "USB 设备直通、VirGL 加速、全双工音频与自动 SSH 端口转发。",
  },
  {
    icon: "ph:shield-check",
    title: "近 1000 个系统",
    body: "覆盖主流发行版、各种 BSD，以及 FreeDOS、Haiku、ReactOS 等冷门系统。",
  },
];

const osChips = [
  "Windows 11", "Windows 10", "Windows Server", "macOS Sequoia", "macOS Sonoma",
  "macOS Ventura", "Ubuntu", "Fedora", "NixOS", "Debian", "Arch", "openSUSE",
  "FreeBSD", "OpenBSD", "NetBSD", "Haiku", "FreeDOS", "ReactOS", "KolibriOS", "openIndiana",
];

const stats = [
  { value: "≈1000", label: "支持的系统版本" },
  { value: "2", label: "条命令即可启动" },
  { value: "TPM 2.0", label: "Windows 11 就绪" },
  { value: "ARM64", label: "客户机支持" },
];

const commands = [
  "quickget nixos unstable minimal",
  "quickemu --vm nixos-unstable-minimal.conf",
];
---

<BaseLayout
  title="Quickemu — 快速创建并运行优化的虚拟机"
  description="Quickemu 是 QEMU 的一层封装，自动为 Windows、macOS 与 Linux 创建并运行经过优化的虚拟机。"
>
  <div class="flex min-h-screen flex-col">
    <Header showSidebar={false}>
      <LinkButton slot="actions" href={docsHref} variant="ghost" size="sm" class="shrink-0">
        文档
      </LinkButton>
    </Header>

    <main id="main-content" tabindex="-1" class="flex-1">
      {/* ---------- Hero ---------- */}
      <section class="relative isolate overflow-hidden border-b border-border">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_55%_at_50%_0%,var(--nb-brand-wash),transparent_70%)]"
        >
        </div>
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--nb-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--nb-border)_1px,transparent_1px)] bg-[size:56px_56px] opacity-[0.35] [mask-image:radial-gradient(60%_50%_at_50%_0%,black,transparent)]"
        >
        </div>

        <div class="mx-auto max-w-6xl px-6 pb-20 pt-16 text-center md:pb-28 md:pt-24">
          <div class="relative mx-auto w-fit">
            <div
              aria-hidden="true"
              class="absolute inset-0 -z-10 scale-150 rounded-full bg-brand/20 blur-2xl"
            >
            </div>
            <img
              src={logoHref}
              alt="Quickemu"
              width="512"
              height="512"
              class="h-20 w-20 object-contain select-none md:h-24 md:w-24"
            />
          </div>

          <div class="mt-8 inline-flex items-center gap-2.5 rounded-full border border-border bg-card/70 px-3.5 py-1.5 text-xs font-medium text-muted-foreground backdrop-blur">
            <span class="flex items-center gap-1.5 text-foreground/70">
              <Icon name="ph:windows-logo" class="h-3.5 w-3.5" />
              <Icon name="ph:apple-logo" class="h-3.5 w-3.5" />
              <Icon name="ph:linux-logo" class="h-3.5 w-3.5" />
            </span>
            <span class="h-3 w-px bg-border"></span>
            支持 Windows · macOS · Linux
          </div>

          <h1 class="mx-auto mt-6 max-w-4xl text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl md:text-6xl">
            一个命令，启动
            <span class="bg-[linear-gradient(90deg,var(--nb-brand),oklch(0.68_0.17_45))] bg-clip-text text-transparent">任何操作系统</span>
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-pretty text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
            Quickemu 是 <a href="https://www.qemu.org/" target="_blank" rel="noopener" class="font-medium text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-brand">QEMU</a>
            的一层封装，会自动<span class="font-medium text-foreground">“做出正确的选择”</span>。你决定运行哪个系统，剩下的交给它。
          </p>

          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <LinkButton href={installHref} variant="primary" size="lg" icon>
              快速开始
            </LinkButton>
            <LinkButton href={docsHref} variant="secondary" size="lg">
              阅读文档
            </LinkButton>
            <LinkButton href={githubHref} variant="ghost" size="lg" target="_blank" rel="noopener">
              <Icon name="ph:github-logo" class="me-1.5 h-4 w-4" />
              GitHub
            </LinkButton>
          </div>

          {/* 终端演示 */}
          <div class="mx-auto mt-14 max-w-2xl overflow-hidden rounded-xl border border-border bg-card text-left shadow-lg">
            <div class="flex items-center gap-2 border-b border-border bg-muted/60 px-4 py-2.5">
              <span class="size-3 rounded-full bg-[#ff5f57]"></span>
              <span class="size-3 rounded-full bg-[#febc2e]"></span>
              <span class="size-3 rounded-full bg-[#28c840]"></span>
              <span class="ms-2 inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
                <Icon name="ph:terminal-window" class="h-3.5 w-3.5" />
                bash — quickemu
              </span>
            </div>

            <div class="divide-y divide-border/60">
              {commands.map((cmd) => (
                <div class="group flex items-center gap-3 px-4 py-4 font-mono text-xs sm:px-5 sm:text-sm">
                  <span class="select-none text-brand">$</span>
                  <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap text-foreground">{cmd}</code>
                  <button
                    type="button"
                    data-copy={cmd}
                    aria-label={`复制命令：${cmd}`}
                    class="flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground opacity-0 transition-all hover:bg-accent hover:text-foreground focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2 group-hover:opacity-100 max-md:opacity-60"
                  >
                    <Icon name="ph:copy" data-copy-idle class="h-3.5 w-3.5" />
                    <Icon name="ph:check" data-copy-done class="hidden h-3.5 w-3.5 text-success" />
                  </button>
                </div>
              ))}

              <div class="flex items-center gap-3 px-4 py-4 font-mono text-xs sm:px-5 sm:text-sm">
                <span class="select-none text-brand">$</span>
                <span class="inline-flex items-center gap-1.5 text-muted-foreground">
                  <span
                    aria-hidden="true"
                    class="inline-block h-4 w-2 animate-pulse bg-brand/70 align-middle motion-reduce:animate-none"
                  ></span>
                </span>
              </div>
            </div>

            <div class="border-t border-border/60 bg-muted/30 px-5 py-3 text-xs">
              <span class="inline-flex items-center gap-1.5 text-muted-foreground">
                <Icon name="ph:check-circle" class="h-3.5 w-3.5 text-success" />
                虚拟机已启动 · 自动匹配硬件与网络
              </span>
            </div>
          </div>

          {/* 数据 */}
          <dl class="mx-auto mt-14 grid max-w-3xl grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-4">
            {stats.map((s) => (
              <div class="flex flex-col bg-card px-4 py-6">
                <dd class="order-1 text-2xl font-semibold tracking-tight text-foreground">{s.value}</dd>
                <dt class="order-2 mt-1 text-xs font-medium text-muted-foreground">{s.label}</dt>
              </div>
            ))}
          </dl>
        </div>
      </section>

      {/* ---------- 工作方式 ---------- */}
      <section id="how" class="border-b border-border">
        <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
          <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand">工作方式</span>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">两条命令，一个完整流程</h2>
            <p class="mt-4 text-base leading-7 text-muted-foreground">
              从空目录到运行中的虚拟机，中间没有任何需要你手写的配置。
            </p>
          </div>

          <ol class="mt-14 grid gap-6 md:grid-cols-3">
            {steps.map((step, i) => (
              <li class="relative rounded-xl border border-border bg-card p-6 shadow-sm">
                <div class="flex items-center gap-3">
                  <span class="flex size-9 items-center justify-center rounded-lg bg-brand-wash text-sm font-semibold text-brand">
                    {i + 1}
                  </span>
                  <Icon name={step.icon} class="h-5 w-5 text-muted-foreground" />
                </div>
                <h3 class="mt-4 text-base font-semibold text-foreground">{step.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{step.body}</p>
                <code class="mt-4 block overflow-x-auto whitespace-nowrap rounded-md bg-code-tint px-3 py-2 font-mono text-xs text-foreground">{step.cmd}</code>
              </li>
            ))}
          </ol>

          <div class="mt-10 text-center">
            <LinkButton href={installHref} variant="secondary" icon>
              查看安装指南
            </LinkButton>
          </div>
        </div>
      </section>

      {/* ---------- 特性 ---------- */}
      <section id="features" class="border-b border-border bg-muted/40">
        <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
          <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand">能力</span>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">为什么选择 Quickemu</h2>
            <p class="mt-4 text-base leading-7 text-muted-foreground">
              不写 XML、不调参数，把“配置一台虚拟机”压缩成一条命令。
            </p>
          </div>

          <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {features.map((f) => (
              <div class="group relative overflow-hidden rounded-xl border border-border bg-card p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-border-strong hover:shadow-lg motion-reduce:hover:translate-y-0">
                <div
                  aria-hidden="true"
                  class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand/50 to-transparent opacity-0 transition-opacity duration-200 group-hover:opacity-100"
                >
                </div>
                <div class="flex size-10 items-center justify-center rounded-lg bg-brand-wash text-brand ring-1 ring-inset ring-brand/10">
                  <Icon name={f.icon} class="h-5 w-5" />
                </div>
                <h3 class="mt-4 text-base font-semibold text-foreground">{f.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ---------- 支持的系统 ---------- */}
      <section id="systems" class="border-b border-border">
        <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
          <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand">系统矩阵</span>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">近 1000 个系统版本</h2>
            <p class="mt-4 text-base leading-7 text-muted-foreground">
              从主流发行版到 BSD 与冷门系统，运行
              <code class="rounded bg-code-tint px-1.5 py-0.5 font-mono text-sm text-foreground">quickget</code>
              即可查看完整列表。
            </p>
          </div>

          <ul class="mx-auto mt-12 flex max-w-4xl flex-wrap items-center justify-center gap-2.5">
            {osChips.map((os) => (
              <li class="rounded-full border border-border bg-card px-3.5 py-1.5 text-sm text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground">
                {os}
              </li>
            ))}
            <li class="rounded-full border border-brand/20 bg-brand-wash px-3.5 py-1.5 text-sm font-medium text-brand">
              以及更多…
            </li>
          </ul>

          <div class="mt-10 text-center">
            <LinkButton href={featuresHref} variant="secondary" icon>
              查看完整特性
            </LinkButton>
          </div>
        </div>
      </section>

      {/* ---------- CTA ---------- */}
      <section id="get-started" class="border-b border-border">
        <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
          <div class="relative isolate overflow-hidden rounded-2xl border border-border bg-card px-6 py-16 text-center shadow-sm">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_120%_at_50%_0%,var(--nb-brand-wash),transparent_70%)]"
            >
            </div>
            <Icon name="ph:rocket" class="mx-auto h-8 w-8 text-brand" />
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">准备好开始了吗？</h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-muted-foreground">
              安装 Quickemu 之后，两条命令即可拉起你的第一台虚拟机。
            </p>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <LinkButton href={installHref} variant="primary" size="lg" icon>
                安装指南
              </LinkButton>
              <LinkButton href={docsHref} variant="secondary" size="lg">
                浏览文档
              </LinkButton>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<script>
  /** 终端命令的复制按钮；兼容 ClientRouter 的前端导航。 */
  function initCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";

      btn.addEventListener("click", async () => {
        const text = btn.dataset.copy ?? "";
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try {
            ok = document.execCommand("copy");
          } catch {
            ok = false;
          }
          ta.remove();
        }
        if (!ok) return;

        const idle = btn.querySelector("[data-copy-idle]");
        const done = btn.querySelector("[data-copy-done]");
        if (!idle || !done) return;
        idle.classList.add("hidden");
        done.classList.remove("hidden");
        window.setTimeout(() => {
          idle.classList.remove("hidden");
          done.classList.add("hidden");
        }, 1200);
      });
    });
  }

  document.addEventListener("astro:page-load", initCopyButtons);
  if (document.readyState !== "loading") initCopyButtons();
</script>
