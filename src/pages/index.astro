<script>
  /* ---------------- 复制命令（带读屏播报） ---------------- */
  const copyTimers = new WeakMap<HTMLButtonElement, number>();

  function initCopyButtons() {
    const announcer = document.getElementById("copy-announcer");

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";

      btn.addEventListener("click", async () => {
        const text = btn.dataset.copy ?? "";
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          // 旧浏览器的回退路径：临时 textarea + execCommand。
          // 通过自定义类型调用，避开 execCommand 的弃用标注。
          const legacy = document as unknown as { execCommand?: (cmd: string) => boolean };
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try {
            ok = legacy.execCommand?.("copy") ?? false;
          } catch {
            ok = false;
          }
          ta.remove();
        }
        if (!ok) return;

        const idle = btn.querySelector("[data-copy-idle]");
        const done = btn.querySelector("[data-copy-done]");
        idle?.classList.add("hidden");
        done?.classList.remove("hidden");

        // 播报到静态 live region（不要动态插入，否则读屏可能捕捉不到）。
        if (announcer) {
          announcer.textContent = "";
          window.requestAnimationFrame(() => {
            announcer.textContent = `已复制：${btn.getAttribute("aria-label") ?? "命令"}`;
          });
        }

        // 清除上一次的重置定时器，避免连点时图标提前复位。
        const prev = copyTimers.get(btn);
        if (prev) window.clearTimeout(prev);
        const timer = window.setTimeout(() => {
          idle?.classList.remove("hidden");
          done?.classList.add("hidden");
          copyTimers.delete(btn);
        }, 1200);
        copyTimers.set(btn, timer);
      });
    });
  }

  /* ---------------- 终端逐字打字（尊重减少动效） ---------------- */
  function initTerminal() {
    const term = document.querySelector<HTMLElement>("[data-term]");
    if (!term || term.dataset.typed === "1") return;
    term.dataset.typed = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const caret = term.querySelector<HTMLElement>("[data-term-caret]");
    if (reduce) {
      caret?.classList.remove("opacity-0");
      return;
    }

    const cmds = [...term.querySelectorAll<HTMLElement>("[data-term-cmd]")];
    const outs = [...term.querySelectorAll<HTMLElement>("[data-term-out]")];
    const sleep = (ms: number) => new Promise((r) => window.setTimeout(r, ms));

    outs.forEach((el) => el.classList.add("opacity-0"));

    (async () => {
      for (const el of cmds) {
        const full = el.dataset.termCmd ?? el.textContent ?? "";
        el.textContent = "";
        for (const ch of full) {
          el.textContent += ch;
          await sleep(16);
        }
        await sleep(240);
      }
      for (const el of outs) {
        el.classList.remove("opacity-0");
        await sleep(140);
      }
      caret?.classList.remove("opacity-0");
    })();
  }

  /* ---------------- asciinema：点击后再加载播放器 ---------------- */
  function initAsciinema() {
    const box = document.querySelector<HTMLElement>("[data-asciinema]");
    const play = box?.querySelector<HTMLButtonElement>("[data-asciinema-play]");
    if (!box || !play || play.dataset.bound === "1") return;
    play.dataset.bound = "1";

    play.addEventListener("click", () => {
      const cast = box.dataset.cast ?? "";
      if (!cast) return;
      box.innerHTML = "";
      const script = document.createElement("script");
      script.src = `https://asciinema.org/a/${cast}.js`;
      script.id = `asciicast-${cast}`;
      script.async = true;
      box.appendChild(script);
    });
  }

  /* ---------------- 安装 Tabs：按平台预选 ---------------- */
  function initInstallTabs() {
    const wrap = document.querySelector<HTMLElement>("[data-install-tabs]");
    if (!wrap || wrap.dataset.autoSelected === "1") return;

    // 只按平台名粗略判断；无法判断时保持默认（Ubuntu）。
    const ua = navigator.userAgent;
    const target = /Mac|iPhone|iPad/.test(ua)
      ? "macOS"
      : /Arch/i.test(ua)
        ? "Arch"
        : /Fedora/i.test(ua)
          ? "Fedora"
          : /Ubuntu/i.test(ua)
            ? "Ubuntu"
            : "";
    if (!target) return;
    wrap.dataset.autoSelected = "1";

    // 等 tabs 客户端生成好触发器再点选。
    window.setTimeout(() => {
      const trigger = [...wrap.querySelectorAll<HTMLElement>("[data-nb-tabs-trigger]")].find(
        (t) => t.textContent?.trim() === target,
      );
      trigger?.click();
    }, 80);
  }

  function initAll() {
    initCopyButtons();
    initTerminal();
    initAsciinema();
    initInstallTabs();
  }

  document.addEventListener("astro:page-load", initAll);
  if (document.readyState !== "loading") initAll();
</script>
