    </main>

    {/* 复制结果的读屏播报区：静态存在，屏幕阅读器才能可靠捕捉到内容变化。 */}
    <div
      id="copy-announcer"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class="sr-only"
    >
    </div>

    <Footer />
